root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{kt,kts}]
ktlint_code_style = ktlint_official
max_line_length = 120
# File names mirror the original Python modules (graph_querier.py -> GraphQuerier.kt), not the class inside.
ktlint_standard_filename = disabled

[*.{json,yml,yaml,toml,md}]
indent_size = 2
